{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/testimonials",
      "destination": "/reviews",
      "permanent": true
    },
    {
      "source": "/demo",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about-us",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/llms", "destination": "/llms.txt" }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ]
}
