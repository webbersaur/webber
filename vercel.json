{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "webber-eta.vercel.app" }],
      "destination": "https://www.webbersaurus.com/:path",
      "permanent": true
    },
    {
      "source": "/testimonials",
      "destination": "/reviews",
      "permanent": true
    },
    {
      "source": "/demo",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about-us",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/llms", "destination": "/llms.txt" }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ]
}
